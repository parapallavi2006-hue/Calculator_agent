      "parameters": {
        "jsCode": "const conversation = $json.Conversation || $json.conversation || '';\n\nconst memory = $getWorkflowStaticData('global');\nif (!memory.faqHistory) {\n  memory.faqHistory = [];\n}\n\nreturn [{\n  json: {\n    conversation,\n    previousFaqs: memory.faqHistory.slice(-10)\n  }\n}];"
      },
      "id": "e32dc1d9-e05d-4ec8-a7bc-c52f404e5950",
