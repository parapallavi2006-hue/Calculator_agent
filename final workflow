        3424,
        976
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'qwen/qwen3.8-27b', temperature: 0.2, messages: [{ role: 'system', content: 'You are the Community FAQ Generator. Extract question-answer pairs from the supplied conversation, merge duplicate or very similar questions, and write clear concise answers using only information present in the conversation. Return ONLY valid JSON in this exact format: {\"faqs\":[{\"question\":\"...\",\"answer\":\"...\",\"category\":\"...\",\"confidence\":\"High|Medium|Low\"}]}. Do not invent information.' }, { role: 'user', content: 'Conversation:\\n' + $json.conversation + '\\n\\nPrevious FAQ memory:\\n' + JSON.stringify($json.previousFaqs) } ] }) }}",
        "options": {}
      },
      "id": "6e0c4b63-f16c-4b07-963b-cc5bb8c5410c",
      "name": "Groq FAQ Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3648,
        976
      ]
    },
    {
      "parameters": {
        "jsCode": "const content = $json.choices?.[0]?.message?.content || '';\n\nlet clean = content\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```$/i, '')\n  .trim();\n\nlet result;\n\ntry {\n  result = JSON.parse(clean);\n} catch (error) {\n  result = {\n    faqs: [],\n    error: 'Groq returned invalid JSON.',\n    raw: clean\n  };\n}\n\nconst memory = $getWorkflowStaticData('global');\n\nif (!memory.faqHistory) {\n  memory.faqHistory = [];\n}\n\nif (Array.isArray(result.faqs)) {\n  memory.faqHistory.push(...result.faqs);\n  memory.faqHistory = memory.faqHistory.slice(-20);\n}\n\nconst html = result.faqs?.length\n  ? result.faqs.map((faq, index) => `\n      <div style=\"background:#ffffff;border-radius:12px;padding:20px;margin:15px 0;box-shadow:0 3px 12px rgba(0,0,0,.08)\">\n        <h3 style=\"color:#2563eb;margin-top:0\">${index + 1}. ${String(faq.question || '').replace(/</g,'&lt;')}</h3>\n        <p style=\"line-height:1.6\">${String(faq.answer || '').replace(/</g,'&lt;')}</p>\n        <small style=\"color:#666\">\n          Category: ${String(faq.category || 'General').replace(/</g,'&lt;')}\n          &nbsp; | &nbsp;\n          Confidence: ${String(faq.confidence || 'Medium').replace(/</g,'&lt;')}\n        </small>\n      </div>\n    `).join('')\n  : '<div style=\"background:#fff7ed;padding:20px;border-radius:10px\">No FAQ entries were generated.</div>';\n\nreturn [{\n  json: {\n    ...result,\n    html\n  }\n}];"
      },
