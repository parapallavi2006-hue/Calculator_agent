      "id": "7",
      "name": "Ingestion Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const messages=$json.messages||[]; const questions=[];\nfor(const m of messages){const text=String(m.text||\"\").trim(); if(!text)continue;\nconst looks=/\\?\\s*$/.test(text)||/^(how|what|where|when|why|who|which|can|could|is|are|do|does|did|will|should)\\b/i.test(text);\nif(!looks)continue;\nconst replies=messages.filter(r=>r.id!==m.id&&((m.thread_ts&&r.thread_ts===m.thread_ts)||(m.thread_ts&&r.ts===m.thread_ts))).map(r=>({user:r.user||\"unknown\",text:String(r.text||\"\")})).filter(r=>r.text);\nquestions.push({question:text,questionId:m.id||m.ts||String(questions.length+1),user:m.user||\"unknown\",replies});}\nreturn [{json:{...$json,candidates:questions}}];"
      },
      "id": "8",
      "name": "Extractor Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const candidates=$json.candidates||[]; const groups=[];\nfunction key(q){return q.toLowerCase().replace(/[^a-z0-9\\s]/g,\" \").replace(/\\b(please|can|could|i|we|you|do|does|is|are|the|a|an)\\b/g,\" \").replace(/\\s+/g,\" \").trim();}\nfor(const item of candidates){const k=key(item.question); let group=groups.find(g=>{const a=new Set(g.key.split(\" \")),b=new Set(k.split(\" \"));const overlap=[...a].filter(x=>b.has(x)).length;return overlap>=Math.min(3,Math.max(1,Math.ceil(Math.min(a.size,b.size)*0.5)));});\nif(!group){group={clusterId:`FAQ-${groups.length+1}`,key:k,questions:[]};groups.push(group);} group.questions.push(item);}\nreturn [{json:{...$json,clusters:groups}}];"
      },
      "id": "9",
      "name": "Clustering Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {model:'gpt-4o-mini',temperature:0.2,response_format:{type:'json_object'},messages:[{role:'system',content:'You are the Answer-Synthesis Agent for a community FAQ system. Create concise, factual FAQ entries only from supplied conversation evidence. Do not invent information. Return JSON with an array named faq.'},{role:'user',content:'Create one FAQ entry per cluster. Each entry must contain clusterId, question, answer, confidence (0 to 1), category, and evidence. Data:\\n'+JSON.stringify($json.clusters)}]} }}",
        "options": {}
      },
      "id": "10",
      "name": "Answer-Synthesis Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw=$json.choices?.[0]?.message?.content??'{\"faq\":[]}'; let parsed;\ntry{parsed=typeof raw===\"string\"?JSON.parse(raw):raw}catch(e){parsed={faq:[],parseError:e.message,raw};}\nconst faq=(parsed.faq||[]).map(x=>({...x,reviewRequired:Number(x.confidence??0)<0.75||!x.answer}));\nreturn [{json:{faq,reviewSummary:{total:faq.length,needsHumanReview:faq.filter(x=>x.reviewRequired).length},generatedAt:new Date().toISOString()}}];"
      },
      "id": "11",
      "name": "Review Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.reviewSummary.needsHumanReview }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "12",
      "name": "Human Review Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const faq=$json.faq||[]; const approved=faq.filter(x=>!x.reviewRequired); let md='# Community FAQ\\n\\n';\nfor(const item of approved){md+=`## ${item.question}\\n\\n${item.answer}\\n\\n**Category:** ${item.category||'General'}  \\n**Confidence:** ${item.confidence??'N/A'}\\n\\n`;}\nreturn [{json:{...$json,markdown:md,approvedFaq:approved}}];"
      },
      "id": "13",
      "name": "Formatter Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{status:\"HUMAN_REVIEW_REQUIRED\",reviewItems:($json.faq||[]).filter(x=>x.reviewRequired),message:\"Approve, edit, or reject flagged FAQ entries before publishing.\"}}];"
      },
      "id": "14",
